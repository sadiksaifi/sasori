{
  "name": "sasori",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-model AI coding agent harness",
  "author": "Sadik Saifi",
  "workspaces": ["apps/*", "packages/*"],
  "catalog": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2",
    "zod": "^4.3.6",
    "vitest": "^4.1.1",
    "tailwindcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "oxlint": "^1.57.0",
    "oxfmt": "^0.42.0",
    "rimraf": "^6.1.3",
    "@phosphor-icons/react": "^2.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:check": "turbo run format:check",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck && turbo run lint && turbo run format:check",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "desktop:dev": "turbo run dev --filter=@repo/desktop",
    "desktop:build": "turbo run build --filter=@repo/desktop",
    "desktop:lint": "turbo run lint --filter=@repo/desktop",
    "desktop:lint:fix": "turbo run lint:fix --filter=@repo/desktop",
    "desktop:format:check": "turbo run format:check --filter=@repo/desktop",
    "desktop:format:fix": "turbo run format:fix --filter=@repo/desktop",
    "desktop:typecheck": "turbo run typecheck --filter=@repo/desktop",
    "desktop:check": "turbo run typecheck --filter=@repo/desktop && turbo run lint --filter=@repo/desktop && turbo run format:check --filter=@repo/desktop",
    "desktop:test": "turbo run test --filter=@repo/desktop",
    "desktop:clean": "turbo run clean --filter=@repo/desktop"
  },
  "devDependencies": {
    "turbo": "^2.8.20"
  },
  "packageManager": "bun@1.3.10",
  "license": "MIT",
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  }
}